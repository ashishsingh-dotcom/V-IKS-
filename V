     nb.onclick=function(){if(dead)end(false);else{n++;ask()}};
     f.appendChild(nb)};
    go.appendChild(b)})}
  if(cfg.timer)tm=setInterval(function(){left--;var e=box.querySelector('#gt');if(e)e.textContent='Time '+Math.max(left,0)+'s';if(left<=0)end(right>=cfg.need)},1000);
  ask()}
